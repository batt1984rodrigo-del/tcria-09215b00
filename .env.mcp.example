# TCRIA MCP Gateway environment template
# Copy to .env locally or configure these values in your deployment platform.

TCRIA_MCP_REQUIRE_AUTH=true
TCRIA_MCP_JWT_ALGORITHM=HS256
TCRIA_MCP_JWT_ISSUER=tcria-mcp-gateway
TCRIA_MCP_JWT_SECRET=replace-with-a-long-random-secret
TCRIA_MCP_SIGNING_SECRET=replace-with-a-different-long-random-secret
TCRIA_MCP_PUBLIC_URL=https://your-mcp-gateway.example.com/mcp

TCRIA_LOG_LEVEL=INFO
TCRIA_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Deployment notes:
# - Never commit real secrets.
# - Use Railway/Render/GitHub Actions secrets for production values.
# - Use separate JWT and artifact signing secrets.
